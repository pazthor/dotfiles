#!/usr/bin/env bash
set -euo pipefail
shopt -s lastpipe

##? Usage: dot [<context>] [<script>] [args...]
##? Run a script by context/name or by its unambiguous name.
##? With no script, open the fzf picker (fzf is only needed for selection).
##? Use dot <context> <script> -h to read a script's ##? help comments.
##? Picker arguments are split on whitespace; quotes and globs are literal.
##? For arguments containing spaces, invoke directly: dot config adopt "path with spaces"
##? DOTFILES_PATH overrides the discovered repository root.

show_help() {
  local file=$1 line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == '##?'* ]] || continue
    line=${line#'##?'}
    printf '%s\n' "${line# }"
  done < "$file"
}

list_commands() {
  local root=$1 entry
  find "$root/scripts" -mindepth 2 -maxdepth 2 -type f -executable \
    ! -name '_*' -printf '%P\0' | sort -z |
    while IFS= read -r -d '' entry; do
      [[ ${entry%%/*} == _* ]] && continue
      printf '%s\0' "$entry"
    done
}

pick_command() {
  local root=$1 selected target
  shift
  local -a choices=() args=()
  if ! command -v fzf >/dev/null 2>&1; then
    echo 'Error: interactive selection requires fzf; install it or invoke a script directly.' >&2
    return 1
  fi
  if (( $# == 0 )); then
    echo 'Error: no commands available.' >&2
    return 1
  fi
  # shellcheck disable=SC2016 # Expanded by the fzf preview shell.
  if ! printf '%s\0' "$@" | fzf --read0 --print0 --height 100% \
      --preview 'sed -n "s/^##? *//p" "$DOTFILES_PATH/scripts/"{}' |
      mapfile -d '' -t choices; then
    return 1
  fi
  [[ ${#choices[@]} == 1 && -n ${choices[0]} ]] || return 1
  selected=${choices[0]}
  # Only execute an entry from the discovery result.
  for target in "$@"; do
    [[ "$selected" == "$target" ]] || continue
    IFS=$' \t\n' read -r -a args -p '> ' || true
    "$root/scripts/$target" "${args[@]}"
    return $?
  done
  echo 'Error: invalid picker selection.' >&2
  return 1
}

main() {
  local self root context name target entry
  local -a commands=() matches=() scoped=()
  self=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    show_help "$self"
    return
  fi
  root=$(realpath -e -- "${DOTFILES_PATH:-${self%/*}/..}") || return 1
  export DOTFILES_PATH="$root"
  if ! list_commands "$root" | mapfile -d '' -t commands; then
    echo "Error: cannot discover commands in $root/scripts" >&2
    return 1
  fi
  if (( $# == 0 )); then
    pick_command "$root" "${commands[@]}"
    return $?
  fi
  context=$1
  if [[ "$context" != */* && "$context" != _* && -d "$root/scripts/$context" ]]; then
    shift
    for entry in "${commands[@]}"; do
      [[ ${entry%/*} == "$context" ]] && scoped+=("$entry")
    done
    if (( $# == 0 )); then
      pick_command "$root" "${scoped[@]}"
      return $?
    fi
    name=$1; shift
    for entry in "${scoped[@]}"; do
      [[ ${entry##*/} == "$name" ]] && matches+=("$entry")
    done
  else
    name=$1; shift
    for entry in "${commands[@]}"; do
      [[ ${entry##*/} == "$name" ]] && matches+=("$entry")
    done
  fi
  case ${#matches[@]} in
    0) printf "Error: no script named '%s' found in the selected context(s).\n" "$name" >&2; return 1 ;;
    1) target="$root/scripts/${matches[0]}" ;;
    *) printf "Error: '%s' is ambiguous, matches:\n" "$name" >&2
       printf '  %s\n' "${matches[@]}" >&2; return 1 ;;
  esac
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    show_help "$target"
    return
  fi
  exec "$target" "$@"
}

main "$@"
