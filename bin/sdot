#!/usr/bin/env bash
set -euo pipefail

##? Usage: sdot [<context>] [<script>] [args...]
##? Run the sibling dot dispatcher with the inherited environment.
##? Does not load .bashrc or other shell startup files.

main() {
  local self
  self=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
  exec "${self%/*}/dot" "$@"
}

main "$@"
