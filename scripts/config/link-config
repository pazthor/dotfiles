#!/usr/bin/env bash
set -euo pipefail

##? Usage: link-config [--force] <path>
##? Link a file from config/ to its home location, backing up existing regular files.
##? --force skips confirmation when contents differ; foreign symlinks are rejected.
##? Exit status: 0 linked, 2 already linked or declined, 1 failed.

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/config/_paths.sh
source "$script_dir/_paths.sh"

main() {
  local root home_path repo_path backup confirm status force=0
  local -a paths=()
  while (( $# )); do
    case $1 in
      --force) force=1 ;;
      -h|--help) echo 'Usage: link-config [--force] <path>'; return 0 ;;
      --) shift; paths+=("$@"); break ;;
      -*) printf 'Error: unknown option: %s\n' "$1" >&2; return 1 ;;
      *) paths+=("$1") ;;
    esac
    shift
  done
  if (( ${#paths[@]} != 1 )); then echo 'Usage: link-config [--force] <path>' >&2; return 1; fi
  root=$(cd -- "$script_dir/../.." && pwd -P) || return 1
  home_path=$(config_home_path "${paths[0]}" "$HOME" "$root") || return 1
  repo_path=$(config_repo_path "$home_path" "$HOME" "$root") || return 1
  if [[ ! -f "$repo_path" ]]; then
    printf 'Error: file not found in repo: %s (use dot config adopt first)\n' "$repo_path" >&2
    return 1
  fi
  if [[ -L "$home_path" ]]; then
    if config_link_matches "$home_path" "$repo_path"; then
      printf 'Already linked: %s -> %s\n' "$home_path" "$repo_path"
      return 2
    fi
    printf 'Error: foreign or broken symlink: %s\n' "$home_path" >&2
    return 1
  fi
  if [[ -e "$home_path" && ! -f "$home_path" ]]; then
    printf 'Error: expected a regular file or missing path: %s\n' "$home_path" >&2
    return 1
  fi
  if [[ -f "$home_path" ]]; then
    if diff -q -- "$repo_path" "$home_path" >/dev/null; then
      status=0
    else
      status=$?
    fi
    if (( status > 1 )); then
      printf 'Error: could not compare %s\n' "$home_path" >&2
      return 1
    fi
    if (( status == 1 )); then
      diff --color=auto -u -- "$repo_path" "$home_path" || true
      if (( ! force )); then
        confirm=''
        read -r -p 'Replace home file with symlink to repo? Repo version wins. [y/N] ' confirm || true
        if [[ "$confirm" != y && "$confirm" != Y ]]; then
          printf 'Skipped: %s\n' "$home_path"
          return 2
        fi
      fi
    fi
    backup=$(config_backup_path "$home_path") || return 1
    mv -- "$home_path" "$backup" || return 1
    printf 'Backup: %s\n' "$backup"
  fi
  mkdir -p -- "${home_path%/*}" || return 1
  ln -s -- "$repo_path" "$home_path" || return 1
  printf 'Linked: %s -> %s\n' "$home_path" "$repo_path"
}

main "$@"
