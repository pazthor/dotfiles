#!/usr/bin/env bash
set -euo pipefail

##? Usage: unadopt <path>
##? Restore an adopted home symlink as a plain file and stage its repo removal.
##? Only links to their expected config/ file are accepted. Commit the removal afterward.

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/config/_paths.sh
source "$script_dir/_paths.sh"

main() {
  local root home_path repo_path temporary
  case ${1:-} in -h|--help) echo 'Usage: unadopt <path>'; return 0 ;; esac
  if (( $# != 1 )); then echo 'Usage: unadopt <path>' >&2; return 1; fi
  root=$(cd -- "$script_dir/../.." && pwd -P) || return 1
  home_path=$(config_home_path "$1" "$HOME" "$root") || return 1
  repo_path=$(config_repo_path "$home_path" "$HOME" "$root") || return 1
  if [[ ! -f "$repo_path" ]] || ! config_link_matches "$home_path" "$repo_path"; then
    printf 'Error: expected a working symlink to %s: %s\n' "$repo_path" "$home_path" >&2
    return 1
  fi
  # Keep Git's protection against removing uncommitted work; do not force removal.
  git -C "$root" rm --dry-run -- "$repo_path" >/dev/null || return 1
  temporary=$(mktemp -- "$home_path.tmp.XXXXXX") || return 1
  if ! cp -p -- "$repo_path" "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! git -C "$root" rm -- "$repo_path"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! mv -T -- "$temporary" "$home_path"; then
    printf 'Error: restored contents are preserved at %s\n' "$temporary" >&2
    return 1
  fi
  printf 'Unadopted: %s\nRemoved:   %s\nRun git commit to record the removal.\n' "$home_path" "$repo_path"
}

main "$@"
