#!/usr/bin/env bash
set -euo pipefail
shopt -s lastpipe

##? Usage: bootstrap [--dry-run] [--force]
##? Link tracked config files into $HOME and select hostname-specific monitor overrides.
##? --dry-run prints planned links without writes. --force accepts differing home files.
##? Summary includes the monitor override; already-linked and declined files are skipped.

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/config/_paths.sh
source "$script_dir/_paths.sh"

link_monitors() {
  local target=$1 source=$2 backup
  if [[ ! -f "$source" ]]; then
    printf 'Error: monitor source not found: %s\n' "$source" >&2
    return 1
  fi
  if config_link_matches "$target" "$source"; then
    printf 'Already linked monitor overrides: %s -> %s\n' "$target" "$source"
    return 2
  fi
  # Host selection deliberately refreshes old monitor symlinks. Preserve plain files.
  if [[ ! -L "$target" && -e "$target" ]]; then
    if [[ ! -f "$target" ]]; then
      printf 'Error: monitor target is not a file: %s\n' "$target" >&2
      return 1
    fi
    backup=$(config_backup_path "$target") || return 1
    mv -- "$target" "$backup" || return 1
    printf 'Backup: %s\n' "$backup"
  fi
  mkdir -p -- "${target%/*}" || return 1
  ln -sfnT -- "$source" "$target" || return 1
  printf 'Linked monitor overrides: %s -> %s\n' "$target" "$source"
}

main() {
  local root repo_rel home_path repo_path machine monitor_source status
  local dry_run=0 force=0 linked=0 skipped=0 failed=0
  local -a files=() link_args=()
  while (( $# )); do
    case $1 in
      --dry-run) dry_run=1 ;;
      --force) force=1 ;;
      -h|--help) echo 'Usage: bootstrap [--dry-run] [--force]'; return 0 ;;
      *) printf 'Error: unknown option: %s\n' "$1" >&2; return 1 ;;
    esac
    shift
  done
  root=$(cd -- "$script_dir/../.." && pwd -P) || return 1
  # lastpipe keeps the array in this shell; pipefail preserves Git's status.
  # No temporary file is needed, including during a dry run.
  if ! config_tracked_files "$root" | mapfile -d '' -t files; then
    echo 'Error: cannot discover tracked config files.' >&2
    return 1
  fi
  (( force )) && link_args+=(--force)
  for repo_rel in "${files[@]}"; do
    [[ "$repo_rel" == *'__pycache__'* ]] && continue
    # This destination is managed exclusively by hostname selection below.
    [[ "$repo_rel" == config/.config/hypr/monitors-local.conf ]] && continue
    if ! home_path=$(config_home_path "$HOME/${repo_rel#config/}" "$HOME" "$root") ||
       ! repo_path=$(config_repo_path "$home_path" "$HOME" "$root"); then
      failed=$((failed + 1)); continue
    fi
    if (( dry_run )); then
      printf 'would link: %s -> %s\n' "$home_path" "$repo_path"
      continue
    fi
    if "$script_dir/link-config" "${link_args[@]}" "$home_path"; then status=0; else status=$?; fi
    case $status in
      0) linked=$((linked + 1)) ;;
      2) skipped=$((skipped + 1)) ;;
      *) failed=$((failed + 1)) ;;
    esac
  done
  machine=$(hostname -s) || return 1
  home_path=$(config_home_path "$HOME/.config/hypr/monitors-local.conf" "$HOME" "$root") || return 1
  monitor_source="$root/config/.config/hypr/monitors-local.$machine.conf"
  [[ -f "$monitor_source" ]] || monitor_source="$root/config/.config/hypr/monitors-local.default.conf"
  if (( dry_run )); then
    printf 'would link: %s -> %s\n' "$home_path" "$monitor_source"
    (( failed == 0 ))
    return $?
  fi
  if link_monitors "$home_path" "$monitor_source"; then status=0; else status=$?; fi
  case $status in
    0) linked=$((linked + 1)) ;;
    2) skipped=$((skipped + 1)) ;;
    *) failed=$((failed + 1)) ;;
  esac
  printf '\nBootstrap complete: linked=%s skipped=%s failed=%s\n' "$linked" "$skipped" "$failed"
  (( failed == 0 ))
}

main "$@"
