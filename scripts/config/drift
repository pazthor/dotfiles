#!/usr/bin/env bash
set -euo pipefail
shopt -s lastpipe

##? Usage:
##?   drift [--quiet]
##?
##? Detect drift between the repo and $HOME in managed directories.
##? Reports: candidate (not adopted), not linked, leftover backups.
##? Exit 0 when clean, 1 when drift is found.
##?
##? Options:
##?   --quiet   Suppress the "clean" summary; only print findings.

SCRIPT_NAME=$(basename "$0")

usage() {
  cat >&2 <<USAGE
Usage:
  $SCRIPT_NAME [--quiet]

Detect drift between the repo and \$HOME in directories the repo already manages.

For every \$HOME directory that contains at least one adopted file, report:
  candidate:  regular file not yet adopted into the repo (run adopt-config)
  not linked: tracked repo file whose home path is not a symlink to it (run link-config)
  leftover:   *.bak.* backup created by adopt-config (verify, then delete)

Paths matching a glob in .driftignore (one per line, relative to \$HOME) are
skipped. Use it for secrets, machine-generated files, and intentional exceptions.

Options:
  --quiet   Suppress the "clean" summary; only print findings.

Exit status: 0 when clean, 1 when drift is found.
USAGE
}

quiet=0

while [[ $# -gt 0 ]]; do
  case $1 in
    --quiet)   quiet=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Error: unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/../.." && pwd)

# shellcheck source=scripts/config/_paths.sh
source "$script_dir/_paths.sh"

findings=0

ignore_patterns=()
if [[ -f "$repo_root/.driftignore" ]]; then
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    ignore_patterns+=("$line")
  done < "$repo_root/.driftignore"
fi

# Match a $HOME-relative path against .driftignore globs.
ignored() {
  local rel=$1 pattern
  for pattern in "${ignore_patterns[@]}"; do
    # shellcheck disable=SC2053  # unquoted on purpose: glob match
    if [[ "$rel" == $pattern ]]; then
      return 0
    fi
  done
  return 1
}

declare -A managed_dirs=()
declare -A tracked=()

# Collect tracked files and the home directories they live in.
files=()
if ! config_tracked_files "$repo_root" | mapfile -d '' -t files; then
  echo 'Error: cannot discover tracked config files.' >&2
  exit 1
fi
for repo_rel in "${files[@]}"; do
  [[ "$repo_rel" == *'__pycache__'* ]] && continue
  home_path=$(config_home_path "$HOME/${repo_rel#config/}" "$HOME" "$repo_root")
  tracked["$home_path"]=1
  managed_dirs["${home_path%/*}"]=1
done

# Tracked repo files whose home path is not a symlink into the repo.
for home_path in "${!tracked[@]}"; do
  repo_path=$(config_repo_path "$home_path" "$HOME" "$repo_root")

  if ignored "${home_path#"$HOME/"}"; then
    continue
  fi

  # Repo-tracked symlinks (e.g. links into omarchy) are stored as-is; skip them.
  if [[ -L "$repo_path" ]]; then
    continue
  fi

  if config_link_matches "$home_path" "$repo_path"; then
    continue
  fi
  echo "not linked: $home_path (run: dot config link-config \"$home_path\")"
  findings=1
done

# Unadopted regular files sitting next to adopted ones.
for dir in "${!managed_dirs[@]}"; do
  [[ -d "$dir" ]] || continue

  entries=()
  if ! find "$dir" -mindepth 1 -maxdepth 1 -type f -print0 | sort -z | mapfile -d '' -t entries; then
    printf 'Error: cannot inspect managed directory: %s\n' "$dir" >&2
    exit 1
  fi
  for entry in "${entries[@]}"; do
    if ignored "${entry#"$HOME/"}"; then
      continue
    fi

    # Leftover adopt-config backups get their own category.
    if [[ "$entry" == *.bak.* ]]; then
      echo "leftover:   $entry (verify, then delete)"
      findings=1
      continue
    fi

    if [[ -z "${tracked[$entry]+x}" ]]; then
      echo "candidate:  $entry (run: dot config adopt \"$entry\")"
      findings=1
    fi
  done
done

if (( findings == 0 )); then
  (( quiet )) || echo "No drift: every managed directory is fully adopted and linked."
  exit 0
fi

exit 1
