#!/usr/bin/env bash
set -euo pipefail

##? Usage: adopt <path> | adopt --verify [<path>]
##? Copy a home file into config/, back up the original, symlink it, and git add it.
##? --verify prints the home/repository mapping without changing files.

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/config/_paths.sh
source "$script_dir/_paths.sh"

usage() {
  echo 'Usage: adopt <path> | adopt --verify [<path>]'
}

main() {
  local root source_path repo_path backup verify=0
  root=$(cd -- "$script_dir/../.." && pwd -P) || return 1
  case ${1:-} in
    -h|--help) usage; return 0 ;;
    --verify) verify=1; shift ;;
  esac
  if (( $# > 1 || (verify == 0 && $# != 1) )); then
    usage >&2; return 1
  fi
  if (( verify )); then
    printf '%s\n' 'Canonical mapping model: config/ -> $HOME' \
      '  config/.config/hypr/hyprland.conf -> ~/.config/hypr/hyprland.conf' \
      '  config/bin/my-script -> ~/bin/my-script' \
      'scripts/ contains repository tooling; home scripts belong in config/.'
    (( $# )) || return 0
  fi
  source_path=$(config_home_path "$1" "$HOME" "$root") || return 1
  repo_path=$(config_repo_path "$source_path" "$HOME" "$root") || return 1
  if (( verify )); then
    printf 'Source:      %s\nRepo path:   %s\nHome target: %s\n' "$source_path" "$repo_path" "$source_path"
    return 0
  fi
  if [[ -L "$source_path" || ! -f "$source_path" ]]; then
    printf 'Error: expected a regular, non-symlink home file: %s\n' "$source_path" >&2
    return 1
  fi
  if [[ -e "$repo_path" || -L "$repo_path" ]]; then
    printf 'Error: target already exists in repo: %s\n' "$repo_path" >&2
    return 1
  fi
  backup=$(config_backup_path "$source_path") || return 1
  mkdir -p -- "${repo_path%/*}" || return 1
  cp -- "$source_path" "$repo_path" || return 1
  mv -- "$source_path" "$backup" || return 1
  ln -s -- "$repo_path" "$source_path" || return 1
  git -C "$root" add -- "$repo_path" || return 1
  printf 'Adopted: %s\nBackup:  %s\nRepo:    %s\n' "$source_path" "$backup" "$repo_path"
}

main "$@"
